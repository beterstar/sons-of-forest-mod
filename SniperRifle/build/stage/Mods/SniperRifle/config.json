// ตั้งค่า mod ปืนสไนเปอร์ไม้ (แก้แล้วเปิดเกมใหม่)
{
  // ชื่อและคำอธิบายไอเทมในกระเป๋า
  "itemName": "ปืนสไนเปอร์ไม้",
  "itemDescription": "สไนเปอร์ทำเองจากกิ่งไม้และก้อนหิน ใช้กระสุน 9 มม. (ดาเมจเท่าปืนพก) คลิกขวาค้างเพื่อส่องกล้อง",

  // สูตรคราฟตัวปืน: กิ่งไม้ + ก้อนหินเล็ก
  "sticks": 10,
  "smallRocks": 10,

  // จำนวนกระสุนต่อแม็ก
  "magazineSize": 5,

  // สูตรคราฟกระสุน 9 มม. (ตั้ง output เป็น 0 เพื่อปิดสูตรนั้น)
  //   ก้อนหิน (ก้อนใหญ่ที่ใช้สร้างฐาน) x ammoRockInput  -> กระสุน x ammoRockOutput
  //   ใบไม้ x ammoLeafInput                              -> กระสุน x ammoLeafOutput
  "ammoRockInput": 1,
  "ammoRockOutput": 1000,
  "ammoLeafInput": 3,
  "ammoLeafOutput": 1000,

  // true = คราฟจากใบไม้ จะเติมกระสุน "ทุกชนิด" จนเต็ม (ไรเฟิล 9 มม. ลูกซอง ลูกธนู ฯลฯ)
  // false = ใบไม้ให้แค่กระสุน 9 มม. ตาม ammoLeafOutput
  "ammoLeafFillsAll": true,

  // มุมกล้องตอนส่อง (องศา) ยิ่งน้อยยิ่งซูมไกล: 20 = ซูม ~3.5 เท่า, 12 = ~6 เท่า, 6 = ~12 เท่า
  "scopeFov": 12,

  // true = ตอนส่องกล้อง กระสุนจะพุ่งไปโดนตรงกลางเส้นเล็งเสมอ (ชดเชยกระสุนตกตามระยะ)
  "scopeAimCorrection": true,

  // ปุ่มฉุกเฉินแก้ตัวละครค้าง (ค้างท่าถือปืน/กดอะไรไม่ได้): เก็บของในมือ ล้างท่าถือปืน หยุดคัตซีนที่ค้าง
  // ใส่ชื่อปุ่ม เช่น "F8", "F9", "Home" หรือ "" เพื่อปิด
  "unstuckKey": "F8",

  // หน้าตาปืน: ขยายกล้องเล็งบนตัวปืน [กว้าง, สูง, ยาว] และย้อมสีโทนไม้ [R, G, B] (1,1,1 = สีเดิมของไรเฟิล)
  "showScopeModel": true,
  "scopeScale": [1.25, 1.25, 1.8],
  "tint": [0.80, 0.62, 0.42],

  // ตำแหน่งปืนในกระเป๋าเทียบกับช่องไรเฟิล
  "inventoryOffset": [-0.52, 0, 0]
}
