// ตั้งค่า mod Kelvin Two (แก้แล้วเปิดเกมใหม่)
{
  // ---------- เคลวินตัวที่ 2 ----------
  // เปิด/ปิด เคลวินตัวที่ 2 (false = ไม่เรียก ไม่บัฟ)
  "cloneEnabled": true,

  // ชื่อที่ลอยบนหัว
  "cloneName": "Kelvin 2",

  // สีที่ย้อมตัว [แดง, เขียว, น้ำเงิน] 0.0-1.0  (ค่าเริ่มต้น = ฟ้า)
  "tintRgb": [0.35, 0.65, 1.0],

  // แสดงชื่อบนหัว
  "showNameTag": true,

  // ความไวในการเดิน/ทำงาน (1.0 = เท่าเคลวินปกติ, สูงสุด 3.0)
  // ค่าเริ่มต้น 1.0 (ไม่เร่ง ท่าทางดูปกติ) ใช้วาร์ปกลับบ้านแทน
  "speedMultiplier": 1.0,

  // ระยะมองเห็น (1.0 = ปกติ, สูงสุด 5.0)
  "visionMultiplier": 2.0,

  // ระยะค้นหาของตอนสั่งให้ไปเอาของ (ท่อนไม้ กิ่งไม้ หิน หินก้อนใหญ่ ต้นไม้ อาหาร ฯลฯ)
  // แถวนั้นไม่มีก็ไปหาไกลขึ้นได้ (1.0 = เท่าตัวแรก, สูงสุด 10.0)
  // ไม่ได้ขยายระยะ "ถึงแล้ว/หยิบได้" และจุดวางของ กันเคลวินค้าง
  "searchMultiplier": 5.0,

  // วาร์ปกลับบ้าน: ถือของกลับมาจากที่ไกล จะวาร์ปไปลงก่อนถึงจุดวางของ ~6 เมตร แล้วเดินไปวางเอง
  // ไม่โกง: วาร์ปเฉพาะตอนถือของ "ขากลับ" เท่านั้น (ขาไปหาของยังเดินเอง)
  "warpHome": true,

  // วาร์ปเมื่อจุดวางของไกลกว่ากี่เมตร (30-500)
  "warpMinDistance": 60,

  // วาร์ปได้ทุกกี่วินาที (20-600)
  "warpCooldownSeconds": 60,

  // ความไว้ใจต่อผู้เล่นตอนเรียกออกมา (-100 ถึง 100)
  "sentiment": 100,

  // ไม่มีค่าความสัมพันธ์: ตีแล้วไม่โกรธ ไม่กลัว ไม่งอน รับคำสั่งต่อปกติเสมอ
  // (มีผลกับตัวที่ 2 เท่านั้น ตัวแรกยังเป็นแบบเดิม)
  "alwaysObedient": true,

  // ---------- เครื่องร่อน ----------
  // ลงพื้นแล้วถ้าในกระเป๋าไม่มีเครื่องร่อน ให้เก็บอันที่ตกอยู่ให้อัตโนมัติ
  "gliderAutoPickup": true,

  // ระยะหาเครื่องร่อนรอบจุดที่ลง (เมตร) เก็บอันที่ใกล้ที่สุด
  // อย่าตั้งไกลเกินไป ใน co-op อาจไปหยิบเครื่องร่อนของเพื่อนที่วางอยู่ใกล้ๆ
  "gliderSearchRadius": 10
}
