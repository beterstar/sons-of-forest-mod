// ตั้งค่า mod ตีหินด้วยอีเต้อ (แก้แล้วเปิดเกมใหม่)
{
  // เปิด/ปิด mod
  "enabled": true,

  // ตีหินกี่ครั้งถึงจะได้หิน 1 รอบ (1 = ตีทุกครั้งได้ทุกครั้ง, สูงสุด 50)
  "hitsPerDrop": 1,

  // ได้หินกี่ก้อนต่อรอบ (1-5)
  "stonesPerDrop": 1,

  // เวลาขั้นต่ำระหว่างการตีที่นับ (วินาที) กันนับซ้ำในการเหวี่ยงครั้งเดียว
  "minSecondsBetweenHits": 0.4,

  // ของที่ได้: 0 = หินก้อนใหญ่ (ใช้สร้างฐาน)  ใส่เลขไอเทมอื่นได้ถ้าอยากเปลี่ยน
  "dropItemId": 0
}
