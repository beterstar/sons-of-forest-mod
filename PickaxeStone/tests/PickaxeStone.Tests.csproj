<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline tests for the parts that run without the game, compiled from ..\src directly. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\src\ModConfig.cs" Link="src\ModConfig.cs" />
    <Compile Include="..\src\HitCounter.cs" Link="src\HitCounter.cs" />
    <None Include="..\config.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
